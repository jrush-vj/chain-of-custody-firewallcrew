[Unit]
Description=Chain of Custody transaction witness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coc-witness
Group=coc-witness
EnvironmentFile=/etc/coc-witness/witness.env
WorkingDirectory=/opt/coc-witness
ExecStart=/usr/bin/node /opt/coc-witness/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/coc-witness
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
