# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bankingsystem
DB_USER=postgres_username
DB_PASSWORD=replace-with-a-long-random-database-password

# Replace these with unique, randomly generated values before deployment.
JWT_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-random-key-of-at-least-32-characters

# Server Configuration
PORT=5000
USE_SSL=false
SSL_CERT=
SSL_KEY=
NODE_ENV=production
CORS_ORIGINS=https://bank.jrushvj.dev
EXTERNAL_PAYMENTS_API_KEY=replace-with-a-long-random-api-key

# Independent witness on the Oracle VPS
WITNESS_URL=https://witness.jrushvj.dev
WITNESS_NODE_ID=ct105-ai
WITNESS_HMAC_SECRET=replace-with-the-same-random-secret-configured-on-the-witness
# Set to "required" once the Oracle witness runs the signed-reconcile release; until then the
# reconcile endpoint stays open so Layer 2 keeps working.
WITNESS_RECONCILE_AUTH=

# Off in production unless set to "true": Swagger UI and the tokenless /send-payment portal
# (which credits any IBAN without logging in).
ENABLE_API_DOCS=false
ENABLE_PAYMENT_PORTAL=false

# Database Encryption / TLS
DB_SSL=false

# Frontend Configuration
# Set to the public URL of the backend (e.g. https://api.example.com) if the frontend is hosted on a different domain.
# Leave blank to have the frontend proxy /api requests to the backend service through Docker.
# If you set it, also add that origin to connect-src in frontend/nginx/default.conf (CSP).
FRONTEND_PUBLIC_API_URL=

# Swagger / API Docs
# Provide a comma-separated list of absolute URLs (e.g. https://api.example.com,https://staging.example.com)
# that should appear in the Swagger "Servers" dropdown. Leave empty to use only localhost and the current host.
SWAGGER_SERVER_URLS=
