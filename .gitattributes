# Scripts and configs that run inside Linux hosts/containers must keep LF endings, even when the
# repository is checked out on Windows (CRLF breaks bash shebangs and `docker cp`-ed files).
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
